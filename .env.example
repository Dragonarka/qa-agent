# The bundled "local" environment (environments/local.json) uses the
# local-fixture adapter and needs none of these — it reads a static HTML
# file directly, no network access required.
#
# These are only relevant if you write a script that uses
# ClerkTestUserAdapter (packages/core/src/adapters/clerk-test-user-adapter.ts)
# against a real Clerk-backed app. Never point this at a production Clerk
# instance.
CLERK_SECRET_KEY=

# Only needed if a flow uses an aiAct()/AI-assisted step (see
# packages/core/src/flow/define.ts) — not used by flows/example-login.ts.
ANTHROPIC_API_KEY=
